# === SERVICE CONFIG ===
NEWS_API_PORT=8006
NEWS_API_HOST=0.0.0.0

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === REDIS ===
REDIS_URL=redis://redis:6379
REDIS_MAX_CONNECTIONS=50

# === DATABASE ===
DATABASE_URL=postgresql://aegis:aegis_secure_pass@postgres:5432/aegis

# === SENTIMENT MODEL ===
SENTIMENT_MODEL=finbert
MODEL_CACHE_DIR=/tmp/models

# === NEWS SOURCES ===
RSS_FEEDS_ENABLED=true
OFFICIAL_APIS_ENABLED=true
WEB_SCRAPING_ENABLED=true

# === NEWS UPDATE FREQUENCY ===
NEWS_UPDATE_INTERVAL_MINUTES=15

# === CACHING ===
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# === API KEYS ===
NEWSAPI_KEY=
CRYPTOPANIC_API_KEY=

# === RESILIENCE ===
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
MAX_RETRIES=3
RETRY_INITIAL_DELAY=1.0

# === RATE LIMITING ===
RATE_LIMIT_MAX_CALLS=100
RATE_LIMIT_TIME_PERIOD=60

# === IMPACT SCORING WEIGHTS ===
WEIGHT_REGULATORY=0.35
WEIGHT_MARKET_MENTION=0.25
WEIGHT_SOURCE_CREDIBILITY=0.20
WEIGHT_TEMPORAL=0.15
WEIGHT_SENTIMENT=0.05
TEMPORAL_DECAY_HALF_LIFE=72

# === MOCK MODE ===
MOCK_NEWS_GENERATION=false
MOCK_SENTIMENT_SCORES=false
