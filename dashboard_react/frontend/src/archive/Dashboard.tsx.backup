import React, { useState } from "react";
import { Header } from "../components/Header";
import { MetricCard } from "../components/MetricCard";
import { ConsensusCard } from "../components/ConsensusCard";
import { SystemStatus } from "../components/SystemStatus";
import { AlertBanner } from "../components/AlertBanner";
import AIAnalysisCard from "../components/AIAnalysisCard";
import { OptimizerCard } from "../components/OptimizerCard";
import Backtest from "./Backtest";
import PaperTrading from "./PaperTrading";
import { RegimeBadge } from "../components/RegimeBadge";
import { ConsensusGauge } from "../components/ConsensusGauge";
import { CBRMatches } from "../components/CBRMatches";
import { ExitSignalPanel } from "../components/ExitSignalPanel";
import { PaperTradeLog } from "../components/PaperTradeLog";
import { useMetrics } from "../hooks/useMetrics";
import { useLiveFeed } from "../hooks/useLiveFeed";

type TabType = "metrics" | "ai_analysis" | "optimizer" | "backtest" | "paper_trading" | "intelligence";

export const Dashboard: React.FC = () => {
  const [symbol, setSymbol] = useState<string>("BTC/USDT");
  const [timeframe, setTimeframe] = useState<string>("1h");
  const [activeTab, setActiveTab] = useState<TabType>("metrics");

  // Refresh interval: 60s for 4h+ timeframes, 10s for shorter
  const refreshInterval = ['4h', '1d', '1w', '1month'].includes(timeframe) ? 60000 : 10000;
  const { data, loading, error } = useMetrics(symbol, timeframe, refreshInterval);

  // AEGIS Intelligence — live SSE symbol (strip /USDT suffix)
  const feedSymbol = symbol.replace("/USDT", "").replace("/", "");
  const { data: liveFeed, connected: liveConnected } = useLiveFeed(feedSymbol);

  const handleSymbolChange = (newSymbol: string) => {
    setSymbol(newSymbol);
  };

  const handleTimeframeChange = (newTimeframe: string) => {
    setTimeframe(newTimeframe);
  };

  const tabs: { id: TabType; label: string; icon: string }[] = [
    { id: "metrics", label: "Metrics", icon: "📊" },
    { id: "intelligence", label: "AEGIS Intelligence", icon: "🧠" },
    { id: "ai_analysis", label: "AI Analysis", icon: "🤖" },
    { id: "optimizer", label: "Optimizer", icon: "⚙️" },
    { id: "backtest", label: "Backtest", icon: "📈" },
    { id: "paper_trading", label: "Paper Trading", icon: "📝" },
  ];

  if (error) {
    return (
      <div className="min-h-screen bg-dark">
        <Header
          currentSymbol={symbol}
          onSymbolChange={handleSymbolChange}
          currentTimeframe={timeframe}
          onTimeframeChange={handleTimeframeChange}
        />
        <main className="mx-auto max-w-7xl px-6 py-12">
          <div className="rounded-lg border border-red-500 border-opacity-30 bg-red-500 bg-opacity-10 p-6 text-red-300">
            <h2 className="text-lg font-bold">Error Loading Dashboard</h2>
            <p className="mt-2">{error}</p>
            <p className="mt-4 text-sm text-red-400">
              Make sure the backend is running on http://localhost:8502
            </p>
            <p className="mt-2 text-sm text-red-400">
              Prometheus URL: http://localhost:9090
            </p>
          </div>
        </main>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-dark">
      <Header
        currentSymbol={symbol}
        onSymbolChange={handleSymbolChange}
        currentTimeframe={timeframe}
        onTimeframeChange={handleTimeframeChange}
      />
      <main className="mx-auto max-w-7xl px-6 py-12">
        {/* Tabs Navigation */}
        <div className="mb-8 border-b border-gray-700">
          <div className="flex flex-wrap gap-2">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`px-4 py-3 font-semibold transition-all duration-200 whitespace-nowrap ${
                  activeTab === tab.id
                    ? "border-b-2 border-cyan-400 text-cyan-400"
                    : "border-b-2 border-transparent text-gray-400 hover:text-gray-300"
                }`}
              >
                {tab.icon} {tab.label}
              </button>
            ))}
          </div>
        </div>

        {/* Tab Content */}
        {loading && activeTab === "metrics" ? (
          <div className="flex items-center justify-center py-20">
            <div className="text-center">
              <p className="mb-4 text-xl text-gray-400">
                Loading metrics for {symbol} ({timeframe})...
              </p>
              <div className="inline-block h-8 w-8 animate-spin rounded-full border-4 border-gray-700 border-t-cyan-400"></div>
            </div>
          </div>
        ) : (
          <>
            {/* Metrics Tab */}
            {activeTab === "metrics" && data ? (
              <>
                {/* Info Banner */}
                <div className="mb-8 rounded-lg border border-cyan-700 border-opacity-30 bg-cyan-700 bg-opacity-10 p-4">
                  <p className="text-sm text-cyan-300">
                    📊 Real-time data from Prometheus • Metrics Source: AI Modules • Timeframe: {timeframe}
                  </p>
                </div>

                {/* Alert Banner - Divergences & Risks */}
                {data && <AlertBanner data={data} />}

                {/* Metric Cards */}
                <div className="mb-8 grid gap-6 md:grid-cols-2 lg:grid-cols-5">
                  {Object.values(data.metrics).map((metric) => (
                    <MetricCard key={metric.name} metric={metric} />
                  ))}
                </div>

                {/* Consensus & System Status */}
                <div className="mb-8 grid gap-6 lg:grid-cols-3">
                  <ConsensusCard data={data.consensus} />
                  <SystemStatus health={data.health} />
                </div>

                {/* Footer */}
                <div className="border-t border-gray-700 pt-6 text-center">
                  <p className="text-xs text-gray-500">
                    Auto-refreshing every 10 seconds • Last update:{" "}
                    {new Date(data.timestamp).toLocaleTimeString()}
                  </p>
                </div>
              </>
            ) : null}

            {/* AI Analysis Tab */}
            {activeTab === "ai_analysis" && (
              <div className="mb-8">
                <AIAnalysisCard symbol={symbol} timeframe={timeframe} />
              </div>
            )}

            {/* Optimizer Tab */}
            {activeTab === "optimizer" && (
              <div className="mb-8">
                <OptimizerCard />
              </div>
            )}

            {/* Backtest Tab */}
            {activeTab === "backtest" && (
              <Backtest />
            )}

            {/* Paper Trading Tab */}
            {activeTab === "paper_trading" && (
              <PaperTrading />
            )}

            {/* AEGIS Intelligence Tab — premium live-feed view */}
            {activeTab === "intelligence" && (
              <div className="flex flex-col gap-4">
                {/* Live feed status */}
                <div className="flex items-center gap-2 text-xs text-gray-400">
                  <span
                    className={`inline-block h-2 w-2 rounded-full ${
                      liveConnected ? "bg-green-500" : "bg-red-500"
                    }`}
                  />
                  {liveConnected ? "Live feed connected" : "Reconnecting…"}
                  {liveFeed && (
                    <span className="ml-auto">
                      Last update:{" "}
                      {new Date(liveFeed.timestamp).toLocaleTimeString()}
                    </span>
                  )}
                </div>

                {liveFeed ? (
                  <>
                    {/* Row 1: Regime + Consensus Gauge */}
                    <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                      <RegimeBadge
                        regimeInfo={{
                          regime: liveFeed.regime,
                          event_risk_score: liveFeed.event_risk_score,
                          hours_to_event: liveFeed.hours_to_event,
                          allocation: liveFeed.regime_allocation,
                        }}
                      />
                      <div className="lg:col-span-2">
                        <ConsensusGauge data={liveFeed.consensus} />
                      </div>
                    </div>

                    {/* Row 2: CBR Matches + Exit Signal */}
                    <div className="grid gap-4 md:grid-cols-2">
                      <CBRMatches matches={liveFeed.cbr_matches} />
                      <ExitSignalPanel
                        data={liveFeed.exit_signal}
                        positionSide="LONG"
                      />
                    </div>

                    {/* Row 3: Paper Trade Log */}
                    <PaperTradeLog data={liveFeed.paper_trade} />
                  </>
                ) : (
                  <div className="flex items-center justify-center py-20">
                    <div className="text-center">
                      <p className="mb-4 text-xl text-gray-400">
                        Connecting to AEGIS Intelligence feed…
                      </p>
                      <div className="inline-block h-8 w-8 animate-spin rounded-full border-4 border-gray-700 border-t-cyan-400" />
                    </div>
                  </div>
                )}
              </div>
            )}
          </>
        )}
      </main>
    </div>
  );
};
